<div class="toast" id="toast"></div>

<script>
// Animate storage bar
setTimeout(() => {
  document.getElementById('storageBar').style.width = '38%';
}, 300);

function setView(v) {
  const list = document.getElementById('fileList');
  const grid = document.getElementById('fileGrid');
  const lb = document.getElementById('listViewBtn');
  const gb = document.getElementById('gridViewBtn');
  if (v === 'grid') {
    list.classList.add('hidden');
    grid.classList.add('active');
    lb.classList.remove('active');
    gb.classList.add('active');
  } else {
    list.classList.remove('hidden');
    grid.classList.remove('active');
    lb.classList.add('active');
    gb.classList.remove('active');
  }
}

function setCat(btn) {
  document.querySelectorAll('.cat-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

function triggerUpload() {
  document.getElementById('uploadInput').click();
}

function handleUpload(e) {
  const files = Array.from(e.target.files);
  files.forEach(f => {
    const icons = { 'pdf': '📋', 'xlsx': '📊', 'xls': '📊', 'docx': '📘', 'doc': '📘', 'pptx': '📙', 'ppt': '📙', 'jpg': '🖼️', 'jpeg': '🖼️', 'png': '🖼️', 'gif': '🖼️', 'zip': '📦', 'mp4': '🎬', 'mp3': '🎵' };
    const ext = f.name.split('.').pop().toLowerCase();
    const icon = icons[ext] || '📄';
    const colors = { 'pdf': '#f3e5f5', 'xlsx': '#e8f5e9', 'xls': '#e8f5e9', 'docx': '#e3f2fd', 'doc': '#e3f2fd', 'pptx': '#fff3e0', 'jpg': '#fce4ec', 'png': '#fce4ec', 'zip': '#f0f4ff' };
    const bg = colors[ext] || '#f0f4ff';
    const tags = { 'pdf': 'PDF', 'xlsx': 'Excel', 'xls': 'Excel', 'docx': 'Word', 'doc': 'Word', 'pptx': 'PPT', 'jpg': '画像', 'png': '画像', 'zip': 'ZIP' };
    const tag = tags[ext] || 'ファイル';
    const size = (f.size / 1024).toFixed(0) + ' KB';
    const item = document.createElement('div');
    item.className = 'file-item';
    item.style.animation = 'slideUp 0.3s ease both';
    item.innerHTML = `<div class="file-icon-wrap" style="background:${bg}">${icon}</div><div class="file-info"><div class="file-name">${f.name}</div><div class="file-meta"><span class="file-tag">${tag}</span><span>${size}</span><span>·</span><span>田中 太郎</span></div></div><button class="file-action" onclick="showToast('オプション')">···</button>`;
    document.getElementById('fileList').prepend(item);
  });
  showToast(`${files.length}件アップロードしました 📁`);
  e.target.value = '';
}

// Drag & Drop
const ua = document.getElementById('uploadArea');
ua.addEventListener('dragover', e => { e.preventDefault(); ua.style.borderColor = 'var(--blue-400)'; ua.style.background = 'var(--blue-100)'; });
ua.addEventListener('dragleave', () => { ua.style.borderColor = ''; ua.style.background = ''; });
ua.addEventListener('drop', e => {
  e.preventDefault(); ua.style.borderColor = ''; ua.style.background = '';
  const files = Array.from(e.dataTransfer.files);
  if (files.length) {
    showToast(`${files.length}件アップロードしました 📁`);
  }
});

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}
</script>
</body>
